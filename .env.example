# Copy to .env and fill in. Generate real values with:
#   npm run build && node dist/cli.js gen-secrets >> .env
# The service refuses to start with missing, short or placeholder secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=./data/bastion.db
# Number of reverse-proxy hops to trust for X-Forwarded-For (0 = none).
TRUST_PROXY=0

# 32 random bytes, base64
JWT_SECRET=
AUDIT_HMAC_KEY=
# Derives per-learner challenge flags (v4)
FLAG_HMAC_KEY=
# Key ring for envelope encryption: id:base64(32 bytes)[,id:base64(32 bytes)…]
ENCRYPTION_KEYS=
ACTIVE_KEY_ID=k1

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SCRYPT_LOG_N=17
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=900
