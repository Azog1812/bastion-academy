{
  "name": "bastion",
  "version": "2.0.0",
  "description": "Hardened end-to-end-encrypted notes API with a full DevSecOps supply chain (SAST, SCA, secrets, IaC, container, DAST, SBOM, signing, provenance).",
  "license": "MIT",
  "author": "Florent Roch <florent.roch@hotmail.fr>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Azog1812/bastion-academy.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p web/tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:deps": "npm audit --omit=dev --audit-level=high && npm audit signatures",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "build:web": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jose": "6.2.14",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
