{
  "uid": "bastion-overview",
  "title": "Bastion - overview",
  "tags": [
    "bastion"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
