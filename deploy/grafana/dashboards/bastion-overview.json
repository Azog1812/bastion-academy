    {
      "id": 8,
      "type": "table",
      "title": "Firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "bastion-prometheus"
      },
      "description": "Each alert names its runbook section (docs/runbook.md). Silences are made in Alerting > Silences by a logged-in Grafana user: Alertmanager itself is not reachable from the host (ADR 0018).",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bastion-prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
